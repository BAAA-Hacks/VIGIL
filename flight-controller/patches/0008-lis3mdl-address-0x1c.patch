+    const uint8_t tags[] = { mag->magSensorToUse, 1 };
+    bool found = false;
+
+    for (unsigned i = 0; i < ARRAYLEN(tags) && !found; i++) {
+        if (i > 0 && tags[i] == tags[0]) {
+            break;
+        }
+        mag->busDev = busDeviceInit(BUSTYPE_I2C, DEVHW_LIS3MDL, tags[i], OWNER_COMPASS);
+        if (mag->busDev == NULL) {
+            continue;
+        }
+        found = deviceDetect(mag);
+        if (!found) {
+            busDeviceDeInit(mag->busDev);
+        }
     }
