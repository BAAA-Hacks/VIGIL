 /*
+0x09 Barometric altitude and vertical speed (same packing as Betaflight / EdgeTX)
+Payload:
+uint16_t    Altitude: MSB clear = decimetres + 10000 (-1000 m .. 2276.7 m); MSB set = whole metres
+int8_t      Vertical speed, log-packed: sign * ln(1 + |v| / 100 cm/s) / 0.026
+*/
+static void crsfFrameBaroAltitude(sbuf_t *dst)
+{
+    sbufWriteU8(dst, CRSF_FRAME_BARO_ALTITUDE_PAYLOAD_SIZE + CRSF_FRAME_LENGTH_TYPE_CRC);
+    crsfSerialize8(dst, CRSF_FRAMETYPE_BARO_ALTITUDE);
+
+    const int32_t altitudeDm = lrintf(getEstimatedActualPosition(Z) / 10.0f);
+    uint16_t altitudePacked;
+    if (altitudeDm < -10000) {
+        altitudePacked = 0;
+    } else if (altitudeDm < 0x8000 - 10000) {
+        altitudePacked = altitudeDm + 10000;
+    } else {
+        altitudePacked = 0x8000 | MIN(altitudeDm / 10, 0x7FFF);
+    }
+    crsfSerialize16(dst, altitudePacked);
+
+    const float climbCms = getEstimatedActualVelocity(Z);
+    const float packed = logf(1.0f + fabsf(climbCms) / 100.0f) / 0.026f;
+    crsfSerialize8(dst, (uint8_t)(int8_t)constrainf(climbCms < 0 ? -packed : packed, -127, 127));
+}
+
+/*
+0x88 Redstart IMU (extended header: destination radio, origin flight controller)
+Payload, int16 big-endian each:
+accel x, y, z   milli-g (board frame after alignment)
+gyro x, y, z    0.1 deg/s
+*/
+static void crsfFrameRedstartImu(sbuf_t *dst)
+{
+    sbufWriteU8(dst, CRSF_FRAME_REDSTART_IMU_PAYLOAD_SIZE + CRSF_FRAME_LENGTH_EXT_TYPE_CRC);
+    crsfSerialize8(dst, CRSF_FRAMETYPE_REDSTART_IMU);
+    crsfSerialize8(dst, CRSF_ADDRESS_RADIO_TRANSMITTER);
+    crsfSerialize8(dst, CRSF_ADDRESS_FLIGHT_CONTROLLER);
+    for (int axis = 0; axis < XYZ_AXIS_COUNT; axis++) {
+        crsfSerialize16(dst, (uint16_t)(int16_t)constrainf(acc.accADCf[axis] * 1000.0f, -32768, 32767));
+    }
+    for (int axis = 0; axis < XYZ_AXIS_COUNT; axis++) {
+        crsfSerialize16(dst, (uint16_t)(int16_t)constrainf(gyro.gyroADCf[axis] * 10.0f, -32768, 32767));
+    }
+}
+
+/*
+0x89 Redstart magnetometer (extended header)
+Payload:
+int16_t x, y, z     field, INAV's calibrated sensor counts (board frame after alignment)
+uint16_t            heading, 0.1 deg (INAV attitude yaw; magnetic when bit 0 of flags is set)
+uint8_t             flags: bit 0 = magnetometer detected and healthy
+*/
+static void crsfFrameRedstartMag(sbuf_t *dst)
+{
+    sbufWriteU8(dst, CRSF_FRAME_REDSTART_MAG_PAYLOAD_SIZE + CRSF_FRAME_LENGTH_EXT_TYPE_CRC);
+    crsfSerialize8(dst, CRSF_FRAMETYPE_REDSTART_MAG);
+    crsfSerialize8(dst, CRSF_ADDRESS_RADIO_TRANSMITTER);
+    crsfSerialize8(dst, CRSF_ADDRESS_FLIGHT_CONTROLLER);
+#ifdef USE_MAG
+    const bool healthy = sensors(SENSOR_MAG) && compassIsHealthy();
+    for (int axis = 0; axis < XYZ_AXIS_COUNT; axis++) {
+        crsfSerialize16(dst, (uint16_t)(int16_t)constrainf(mag.magADC[axis], -32768, 32767));
+    }
+#else
+    const bool healthy = false;
+    for (int axis = 0; axis < XYZ_AXIS_COUNT; axis++) {
+        crsfSerialize16(dst, 0);
+    }
+#endif
+    crsfSerialize16(dst, attitude.values.yaw);
+    crsfSerialize8(dst, healthy ? 1 : 0);
+}
