+static void cliFlightLog(char *cmdline)
+{
+    UNUSED(cmdline);
+    const unsigned n = flightRecorderSampleCount();
+    int16_t s[FLIGHT_RECORDER_FIELD_COUNT];
+
+    cliPrintLinef("# flightlog: %u samples, %u ms apart", n, flightRecorderIntervalMs());
+    cliPrintLine("t_ms," FLIGHT_RECORDER_CSV_HEADER);
+    for (unsigned i = 0; i < n; i++) {
+        flightRecorderGetSample(i, s);
+        cliPrintf("%u", i * flightRecorderIntervalMs());
+        for (int f = 0; f < FLIGHT_RECORDER_FIELD_COUNT; f++) {
+            cliPrintf(",%d", s[f]);
+        }
+        cliPrintLinefeed();
+    }
+    cliPrintLine("# end");
+}
