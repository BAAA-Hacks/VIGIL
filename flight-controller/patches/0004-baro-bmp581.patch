+ * along with INAV.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <platform.h>
+
+#include "common/utils.h"
+
+#include "drivers/bus.h"
+#include "drivers/time.h"
+#include "drivers/barometer/barometer.h"
+#include "drivers/barometer/barometer_bmp581.h"
+
+// Bosch BMP581/BMP585 (datasheet BST-BMP581-DS004). The chip outputs compensated
+// values, so no calibration coefficients are needed: pressure = raw / 64 Pa,
+// temperature = raw / 65536 degC.
+
+#if defined(USE_BARO) && defined(USE_BARO_BMP581)
+
+#define BMP581_REG_CHIP_ID          0x01
+#define BMP581_REG_TEMP_DATA_XLSB   0x1D    // followed by TEMP LSB/MSB, PRESS XLSB/LSB/MSB
+#define BMP581_REG_INT_STATUS       0x27
+#define BMP581_REG_STATUS           0x28
+#define BMP581_REG_OSR_CONFIG       0x36
+#define BMP581_REG_ODR_CONFIG       0x37
+#define BMP581_REG_OSR_EFF          0x38
+#define BMP581_REG_CMD              0x7E
+
+#define BMP581_CHIP_ID              0x50
+#define BMP585_CHIP_ID              0x51
+
+#define BMP581_CMD_SOFT_RESET       0xB6
+
+#define BMP581_INT_STATUS_POR       (1 << 4)
+#define BMP581_STATUS_NVM_RDY       (1 << 1)
+#define BMP581_STATUS_NVM_ERR       (1 << 2)
+
+// OSR_CONFIG: press_en, pressure 16x oversampling, temperature 1x
+#define BMP581_OSR_PRESS_EN         (1 << 6)
+#define BMP581_OSR_P_16X            (4 << 3)
+#define BMP581_OSR_T_1X             0
+
+// ODR_CONFIG: deep standby disabled, 50 Hz, power mode
+#define BMP581_ODR_DEEP_DIS         (1 << 7)
+#define BMP581_ODR_50_HZ            (0x0F << 2)
+#define BMP581_PWR_STANDBY          0x00
+#define BMP581_PWR_NORMAL           0x01
+
+#define BMP581_OSR_EFF_ODR_VALID    (1 << 7)
+
+#define BMP581_SAMPLE_RATE_HZ       50
+
+static float pressurePa;
+static float temperatureC;
+
+static uint8_t registerRead(busDevice_t *busDev, uint8_t reg)
+{
+    uint8_t value = 0;
+    busRead(busDev, reg, &value);
+    return value;
+}
+
+static bool deviceConfigure(busDevice_t *busDev)
+{
+    busWrite(busDev, BMP581_REG_CMD, BMP581_CMD_SOFT_RESET);
+    delay(5);
+
+    if ((registerRead(busDev, BMP581_REG_INT_STATUS) & BMP581_INT_STATUS_POR) == 0) {
+        return false;
+    }
+    const uint8_t status = registerRead(busDev, BMP581_REG_STATUS);
+    if ((status & BMP581_STATUS_NVM_RDY) == 0 || (status & BMP581_STATUS_NVM_ERR)) {
+        return false;
+    }
+
+    // Configure in standby, then start continuous (normal mode) measurements
+    busWrite(busDev, BMP581_REG_ODR_CONFIG, BMP581_ODR_DEEP_DIS | BMP581_ODR_50_HZ | BMP581_PWR_STANDBY);
+    delay(5);
+    busWrite(busDev, BMP581_REG_OSR_CONFIG, BMP581_OSR_PRESS_EN | BMP581_OSR_P_16X | BMP581_OSR_T_1X);
+    busWrite(busDev, BMP581_REG_ODR_CONFIG, BMP581_ODR_DEEP_DIS | BMP581_ODR_50_HZ | BMP581_PWR_NORMAL);
+    delay(5);
+
+    // The chip reports whether the oversampling fits in the chosen output rate
+    return (registerRead(busDev, BMP581_REG_OSR_EFF) & BMP581_OSR_EFF_ODR_VALID) != 0;
+}
+
+static bool deviceReadMeasurement(baroDev_t *baro)
+{
+    uint8_t buf[6];
+    if (!busReadBuf(baro->busDev, BMP581_REG_TEMP_DATA_XLSB, buf, sizeof(buf))) {
+        return false;
+    }
+
+    const uint32_t rawPress = ((uint32_t)buf[5] << 16) | ((uint32_t)buf[4] << 8) | buf[3];
+    if (rawPress == 0) {
+        return false;   // no conversion yet
+    }
+
+    // Temperature is a signed 24-bit value: build it in the top bits, then shift back down
+    const int32_t rawTemp = (int32_t)(((uint32_t)buf[2] << 24) | ((uint32_t)buf[1] << 16) | ((uint32_t)buf[0] << 8)) >> 8;
+
+    pressurePa = rawPress / 64.0f;
+    temperatureC = rawTemp / 65536.0f;
+    return true;
+}
+
+static bool deviceCalculate(baroDev_t *baro, int32_t *pressure, int32_t *temperature)
+{
+    UNUSED(baro);
+
+    if (pressure) {
+        *pressure = (int32_t)pressurePa;
+    }
+    if (temperature) {
+        *temperature = (int32_t)(temperatureC * 100);   // centidegrees
+    }
+    return true;
+}
+
+static bool deviceDetect(busDevice_t *busDev)
+{
+    for (int retry = 0; retry < 5; retry++) {
+        uint8_t chipId = 0;
+
+        delay(10);
+        if (busRead(busDev, BMP581_REG_CHIP_ID, &chipId) && (chipId == BMP581_CHIP_ID || chipId == BMP585_CHIP_ID)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool baroBMP581Detect(baroDev_t *baro)
+{
+    // tag 0 = address 0x47 (breakout default), tag 1 = 0x46 (SDO pulled low)
+    for (uint8_t tag = 0; tag < 2; tag++) {
+        baro->busDev = busDeviceInit(BUSTYPE_ANY, DEVHW_BMP581, tag, OWNER_BARO);
+        if (baro->busDev == NULL) {
+            continue;
+        }
+        if (deviceDetect(baro->busDev) && deviceConfigure(baro->busDev)) {
+            baro->ut_delay = 0;
+            baro->start_ut = NULL;
+            baro->get_ut = NULL;
+
+            baro->up_delay = 1000000 / BMP581_SAMPLE_RATE_HZ / 2;   // poll at twice the output rate
+            baro->start_up = NULL;
+            baro->get_up = deviceReadMeasurement;
+
+            baro->calculate = deviceCalculate;
+            return true;
+        }
+        busDeviceDeInit(baro->busDev);
+    }
+    baro->busDev = NULL;
+    return false;
+}
+
+#endif
